									<div class="list-block">
										<h3>项目亮点</h3>
										<ul>
											{project.highlights.map((item) => <li>{item}</li>)}
										</ul>
									</div>
									<div class="list-block">
										<h3>项目成果</h3>
										<ul>
											{project.results.map((item) => <li>{item}</li>)}
										</ul>
									</div>
								</article>
							))}
						</div>
					</details>
				</section>

				<section class="resume-section">
					<h2>教育背景</h2>
					<ul>
						{education.map((item) => <li>{item}</li>)}
					</ul>
				</section>

				<section class="resume-section">
					<h2>证书</h2>
					<ul>
						{certificates.map((item) => <li>{item}</li>)}
					</ul>
				</section>
			</section>
		</main>
		<Footer />
